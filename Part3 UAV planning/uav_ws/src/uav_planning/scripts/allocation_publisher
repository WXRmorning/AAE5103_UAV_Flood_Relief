"""Publish one batch from the independent allocation module's saved results."""

import json
from pathlib import Path
from time import monotonic

import rclpy
from rclpy.duration import Duration
from rclpy.executors import ExternalShutdownException
from std_msgs.msg import String


def load_assignments(results_file):
    """Read the ordered Q-learning assignment rows and encode the whole batch."""
    with Path(results_file).expanduser().open(encoding='utf-8') as stream:
        result = json.load(stream)
    method = result.get('QLearning') if isinstance(result, dict) else None
    rows = method.get('rows') if isinstance(method, dict) else None
    if not isinstance(rows, list) or not rows:
        raise ValueError('结果文件必须含有非空的 QLearning.rows。')

    batch = []
    for index, row in enumerate(rows, 1):
        if not isinstance(row, dict):
            raise ValueError(f'第 {index} 行分配不是对象。')
        drone, hub = row.get('drone'), row.get('hub')
        if drone not in ('UAV 1', 'UAV 2'):
            raise ValueError(f'第 {index} 行的 drone 必须为 UAV 1 或 UAV 2。')
        if not isinstance(hub, str) or len(hub) != 1 or not 'A' <= hub <= 'G':
            raise ValueError(f'第 {index} 行的 hub 必须为 A–G 的单个大写字母。')
        # 保留结果中的行顺序和机号；时间字段是分配模型估计，不驱动仿真起飞。
        batch.append(drone[-1] + hub)
    return ''.join(batch)


def main():
    """Wait for the dispatcher subscription, publish once, and exit."""
    rclpy.init()
    node = rclpy.create_node('allocation_publisher')
    logger = node.get_logger()
    try:
        results_file = node.declare_parameter('results_file', '').value
        if not results_file:
            logger.error('请用 -p results_file:=<JSON 文件路径> 指定已生成的分配结果。')
            return 1
        try:
            assignments = load_assignments(results_file)
        except (OSError, ValueError) as error:
            logger.error(f'未发布任务，读取分配结果失败：{error}')
            return 1

        publisher = node.create_publisher(String, '/assigned_missions', 10)
        logger.info(f'等待 {publisher.topic_name} 的订阅者。')
        deadline = monotonic() + 10.0
        while not publisher.get_subscription_count():
            if monotonic() >= deadline:
                logger.error('未找到分配任务订阅者，请先启动双机仿真。')
                return 1
            rclpy.spin_once(node, timeout_sec=0.1)

        publisher.publish(String(data=assignments))
        if publisher.wait_for_all_acked(Duration(seconds=2)):
            logger.info(f'已发布 {len(assignments) // 2} 个指定机号的任务：{assignments}')
        else:
            # DDS 确认超时无法判断分发节点是否已入队，重复发布会增加一批任务。
            logger.warning(
                f'任务已发布：{assignments}。DDS 确认超时，请先检查分发节点的“收到分配结果”日志。')
        return 0
    except (KeyboardInterrupt, ExternalShutdownException):
        return 130
    finally:
        node.destroy_node()
        if rclpy.ok():
            rclpy.shutdown()


if __name__ == '__main__':
    raise SystemExit(main())
