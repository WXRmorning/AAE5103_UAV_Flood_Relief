#!/usr/bin/env python3
# Copyright 2026 uav_planning contributors
# SPDX-License-Identifier: Apache-2.0
"""Draw planned paths and ground-truth flight tracks in Gazebo Harmonic."""

from collections import deque
import math
import sys

from nav_msgs.msg import Odometry, Path
import rclpy
from rclpy.executors import ExternalShutdownException
from rclpy.node import Node
from rclpy.qos import DurabilityPolicy, QoSProfile, qos_profile_sensor_data

try:
    from gz.msgs10.boolean_pb2 import Boolean
    from gz.msgs10.marker_pb2 import Marker
    from gz.msgs10.marker_v_pb2 import Marker_V
    from gz.transport13 import Node as TransportNode
except ImportError as error:
    sys.exit(f'Install python3-gz-msgs10 and python3-gz-transport13 for flight paths: {error}')

# Planned route and actual track colors, in that order, for each UAV.
COLORS = {
    'uav1': ((0.0, 0.8, 1.0), (0.3, 1.0, 0.15)),  # Cyan, lime green.
    'uav2': ((1.0, 0.62, 0.0), (1.0, 0.15, 0.8)),  # Orange, magenta.
}
TRACK_SPACING = 0.20  # metres between ground-truth samples drawn
TRACK_MAX_POINTS = 3000
BASE_LINK_OFFSET_Z = 0.24  # Gazebo X500 model origin to base_link, in body coordinates.


class FlightPathOverlay(Node):
    """Read ROS 2 paths and odometry, then send line strips to the Gazebo GUI."""

    def __init__(self):
        super().__init__('flight_path_overlay')
        self.transport = TransportNode()
        self.plans = {}
        self.tracks = {name: deque(maxlen=TRACK_MAX_POINTS) for name in COLORS}
        self.dirty = set()
        plan_qos = QoSProfile(depth=1, durability=DurabilityPolicy.TRANSIENT_LOCAL)
        for name in COLORS:
            self.create_subscription(
                Path, f'/{name}/planned_path',
                lambda msg, uav=name: self.on_plan(uav, msg), plan_qos)
            self.create_subscription(
                Odometry, f'/{name}/ground_truth',
                lambda msg, uav=name: self.on_ground_truth(uav, msg), qos_profile_sensor_data)
        self.create_timer(0.25, self.draw)
        self.get_logger().info(
            'Gazebo overlays: UAV1 cyan plan / green track, UAV2 orange plan / magenta track.')

    def on_plan(self, name, msg):
        """Keep the newest complete path, including the planner's start point."""
        if msg.header.frame_id != 'map':
            return
        points = [(p.pose.position.x, p.pose.position.y, p.pose.position.z) for p in msg.poses]
        if len(points) >= 2 and all(math.isfinite(value) for p in points for value in p):
            self.plans[name] = points
            self.dirty.add((name, 1))

    def on_ground_truth(self, name, msg):
        """Track base_link in map coordinates for comparison with the planner."""
        if msg.header.frame_id != 'map':
            return
        p, q = msg.pose.pose.position, msg.pose.pose.orientation
        # Rotate the model-to-body offset by the measured attitude before translating it.
        point = (
            p.x + BASE_LINK_OFFSET_Z * 2 * (q.x * q.z + q.w * q.y),
            p.y + BASE_LINK_OFFSET_Z * 2 * (q.y * q.z - q.w * q.x),
            p.z + BASE_LINK_OFFSET_Z * (1 - 2 * (q.x * q.x + q.y * q.y)),
        )
        track = self.tracks[name]
        if all(math.isfinite(value) for value in point) and (
                not track or math.dist(point, track[-1]) >= TRACK_SPACING):
            track.append(point)
            if len(track) >= 2:
                self.dirty.add((name, 2))

    def draw(self):
        """Submit only changed lines to the GUI, at most four times per second."""
        if not self.dirty:
            return
        if '/marker_array' not in self.transport.service_list():
            self.get_logger().warning(
                'Flight paths are ready, but Gazebo GUI marker service /marker_array is missing.',
                throttle_duration_sec=5.0)
            return
        request = Marker_V()
        for name, marker_id in sorted(self.dirty):
            marker = request.marker.add()
            marker.ns = f'flight_path_{name}'
            marker.id = marker_id
            marker.action = Marker.ADD_MODIFY
            marker.type = Marker.LINE_STRIP
            marker.visibility = Marker.GUI
            color = marker.material.diffuse
            color.r, color.g, color.b = COLORS[name][marker_id - 1]
            color.a = 1.0
            # Ogre classic uses ambient for markers without lighting or a texture.
            marker.material.ambient.CopyFrom(color)
            points = self.plans[name] if marker_id == 1 else self.tracks[name]
            for x, y, z in points:
                marker.point.add(x=x, y=y, z=z)
        ok, reply = self.transport.request(
            '/marker_array', request, Marker_V, Boolean, 150)
        if ok and reply.data:
            for name, marker_id in sorted(self.dirty):
                if marker_id == 1:
                    self.get_logger().info(
                        f'Sent {name} planned path to Gazebo ({len(self.plans[name])} points).')
            self.dirty.clear()
        else:
            self.get_logger().warning(
                'Gazebo did not confirm the flight path markers.', throttle_duration_sec=5.0)


def main():
    """Load the Gazebo Harmonic bindings and spin the standalone overlay node."""
    rclpy.init()
    node = FlightPathOverlay()
    try:
        rclpy.spin(node)
    except (KeyboardInterrupt, ExternalShutdownException):
        pass
    finally:
        node.destroy_node()
        if rclpy.ok():
            rclpy.shutdown()
    return 0


if __name__ == '__main__':
    sys.exit(main())
